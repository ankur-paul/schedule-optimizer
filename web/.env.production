# The production build's public settings (T50, filled in by scripts/go-live-wizard.sh in T51). Committed on purpose:
# none is a secret. The anon key ships in every visitor's bundle anyway, and row-level security guards the data.
# Never put a service_role / secret key here. scripts/smoke.sh, scripts/migrate-prod.sh and the deploy read this
# file too.
#
# Vite loads this file for every `npm run build`, over .env.local. To build against the dev project, put the dev
# values in web/.env.production.local (ignored by git), which wins over this file.
#
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY: the production Supabase project's URL and anon (or publishable) key.
# VITE_SOLVER_URL, VITE_AGENT_URL: the two Function URLs (lattice-solver, lattice-agent), no trailing slash. Unset,
# not empty: an empty VITE_SOLVER_URL= would point the solver at the page's own origin.

VITE_CONTACT_EMAIL=privacy@uselattice.app
