# The production build's public settings (T50; T51 fills them in). Committed on purpose: none is a secret. The anon
# key ships in every visitor's bundle anyway, and row-level security guards the data. Never put a service_role /
# secret key here. scripts/smoke.sh, scripts/migrate-prod.sh and the deploy read this file too.
#
# Vite loads this file for every `npm run build`, over .env.local. To build against the dev project, put the dev
# values in web/.env.production.local (ignored by git), which wins over this file.
#
# The lines stay commented out until T51 has the values: an empty VITE_SOLVER_URL= would point the solver at the
# page's own origin.

# Production Supabase project → Project Settings → Data API → Project URL, and its anon (or publishable) key.
# VITE_SUPABASE_URL=https://<production-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# The two Function URLs that scripts/aws-setup.sh prints, without the trailing slash.
# VITE_SOLVER_URL=https://<id>.lambda-url.ap-south-1.on.aws
# VITE_AGENT_URL=https://<id>.lambda-url.ap-south-1.on.aws

VITE_CONTACT_EMAIL=privacy@uselattice.app
