# Copy to web/.env.local (or run scripts/setup-auth.sh, which writes it for you).
# Without both values the app runs signed out only, exactly as v1, with no Sign in button.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → the anon (public) key, or the publishable key.
# This key is public by design: it ships in the web bundle, and row-level security guards the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=

# The contact address the /privacy and /terms pages print, e.g. privacy@<your domain>.
# Without it the build warns and the pages say "(contact address not set)".
VITE_CONTACT_EMAIL=
