# Supabase dev project, for the RLS tests (`uv run pytest -m supabase`). scripts/setup-supabase-cli.sh fills these
# into server/.env; without them those tests are skipped.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (sb_publishable_…) or legacy anon key. Public by design: RLS guards the data.
SUPABASE_ANON_KEY=
# Secret (sb_secret_…) or legacy service_role key. Bypasses RLS: never commit it or put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
